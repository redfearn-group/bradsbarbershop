---
layout: layouts/base.njk
title: About
description: Brad's Barber Shop has been cutting hair on Main Street in Spanish Fork, Utah, since 1979.
---
<section class="page-head"><div class="wrap">
  <p class="eyebrow">About</p>
  <h1>A Main Street barber shop since {{ shop.foundingYear }}.</h1>
  <p class="lead">Brad's has been cutting hair in downtown Spanish Fork since {{ shop.foundingYear }}. Classic chairs and a pole out front.</p>
</div></section>

<section class="section-tight"><div class="wrap">
  <div class="gallery">
    {%- for p in shop.gallery %}
    <figure class="frame">
      <img src="{{ p.src }}"{% if p.srcSmall %} srcset="{{ p.srcSmall }} 800w, {{ p.src }} {{ p.width }}w" sizes="(min-width: 1160px) 1100px, 100vw"{% endif %} width="{{ p.width }}" height="{{ p.height }}" alt="{{ p.alt }}" loading="lazy">
      {%- if p.caption %}<figcaption>{{ p.caption }}</figcaption>{% endif %}
    </figure>
    {%- endfor %}
  </div>
</div></section>

<section class="section-tight"><div class="wrap grid-3">
  <div class="feat"><div class="plate">{% art "razor" %}</div><h2>The straight-razor finish</h2><p>Every haircut ends with a straight-razor neck shave.</p></div>
  <div class="feat"><div class="plate">{% art "chair" %}</div><h2>Walk in, or call ahead</h2><p>There's no app and no online booking.</p></div>
  <div class="feat"><div class="plate">{% art "shears-comb" %}</div><h2>Cuts for men and kids</h2><p>One short price list and no surprises. See the <a class="text-link" href="/prices/">prices</a>.</p></div>
</div></section>

{%- if shop.barbers.length %}
<section class="section-tight"><div class="wrap">
  <h2 style="font-size:clamp(1.7rem,3.4vw,2.3rem);margin-bottom:18px">The barbers</h2>
  <div class="grid-3">
    {%- for b in shop.barbers %}
    <div class="feat"><h3>{{ b.name }}</h3>{% if b.bio %}<p>{{ b.bio }}</p>{% endif %}</div>
    {%- endfor %}
  </div>
</div></section>
{%- endif %}

<section class="band" aria-label="Reviews and awards"><ul class="wrap proof">
  <li><b>{{ shop.rating.value }} stars</b> <span>Rated on <a href="{{ shop.rating.url }}">{{ shop.rating.source }}</a></span></li>
  {%- for a in shop.awards %}
  <li><b>{{ a.title }}</b> <span>{{ a.detail }}</span></li>
  {%- endfor %}
</ul></section>
