{%- set pageTitle = (title + " | " + shop.name) if title else (shop.name + " | Barber in Spanish Fork, Utah") -%}
{%- set pageDescription = description or shop.description -%}
{%- set canonical = shop.url + page.url -%}
{%- set phoneIcon -%}<svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>{%- endset -%}
{%- set pinIcon -%}<svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>{%- endset -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="theme-color" content="#F7F4EF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0A1128" media="(prefers-color-scheme: dark)">
<meta name="color-scheme" content="light dark">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ shop.url }}/assets/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ shop.name }}, classic cuts on Main Street in Spanish Fork since {{ shop.foundingYear }}">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/assets/favicon.ico" sizes="48x48">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="stylesheet" href="/css/main.css">

<script type="application/ld+json">{{ schema | dump | safe }}</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<div class="util" role="complementary" aria-label="Shop details"><div class="wrap">
  <span>{{ shop.address.street }}, {{ shop.address.city }}, {{ shop.address.region }} {{ shop.address.postalCode }}</span>
  <span data-status>{% for h in shop.hours | hoursSummary %}{{ h.days }} {{ h.time }}{% if not loop.last %}, {% endif %}{% endfor %}</span>
  <a href="tel:{{ shop.phone.tel }}">{{ shop.phone.display }}</a>
</div></div>

<header class="site"><div class="wrap">
  <a class="brand" href="/" aria-label="{{ shop.name }}, home">{% include "logo-razor.svg" %}</a>
  <nav class="main" aria-label="Main">
    {%- for item in [["/", "Home"], ["/prices/", "Prices"], ["/about/", "About"], ["/visit/", "Visit"]] %}
    <a href="{{ item[0] }}"{% if page.url == item[0] %} aria-current="page"{% endif %}>{{ item[1] }}</a>
    {%- endfor %}
  </nav>
  <a class="btn btn-solid" href="tel:{{ shop.phone.tel }}">{{ phoneIcon | safe }}<span class="call-short">Call</span><span class="call-long">Call to book</span></a>
</div></header>

<main id="main">
{{ content | safe }}
</main>

<footer class="site"><div class="wrap">
  <div class="grid">
    <div>
      <a class="brand" href="/" aria-label="{{ shop.name }}, home">{% include "logo-razor.svg" %}</a>
      <p class="tag">Classic haircuts on Main Street since {{ shop.foundingYear }}.</p>
    </div>
    <div>
      <h2>Visit</h2>
      <p>{{ shop.address.street }}<br>{{ shop.address.city }}, {{ shop.address.region }} {{ shop.address.postalCode }}<br><a href="tel:{{ shop.phone.tel }}">{{ shop.phone.display }}</a></p>
      <p><a href="{{ shop.maps.directions }}">Get directions</a></p>
    </div>
    <div>
      <h2>Hours</h2>
      <p>{% for h in shop.hours | hoursSummary %}{{ h.days }}{% if h.time != "Closed" %}: {{ h.time }}{% else %}: Closed{% endif %}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
      <p class="social">{% for s in shop.social %}<a href="{{ s.url }}">{{ s.name }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}</p>
    </div>
  </div>
  <p class="fine">&copy; {% year %} {{ shop.name }}. Walk-ins welcome.</p>
</div></footer>

<div class="callbar">
  <a class="btn btn-solid" href="tel:{{ shop.phone.tel }}">{{ phoneIcon | safe }}Call</a>
  <a class="btn btn-line" href="{{ shop.maps.directions }}">{{ pinIcon | safe }}Directions</a>
</div>

<script>
// Marks today's row in any hours table and replaces [data-status] text with open or closed,
// using the shop's own time zone. Without JavaScript the full week still shows.
(function () {
  try {
    var H = {{ shop.hours | dump | safe }};
    var parts = new Intl.DateTimeFormat("en-US", { timeZone: "{{ shop.timezone }}", weekday: "short", hour: "numeric", minute: "numeric", hour12: false }).formatToParts(new Date());
    var map = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 }, day = 0, now = 0;
    parts.forEach(function (p) {
      if (p.type === "weekday") day = map[p.value];
      if (p.type === "hour") now += (+p.value % 24);
      if (p.type === "minute") now += +p.value / 60;
    });
    var num = function (t) { var a = t.split(":"); return +a[0] + (+a[1]) / 60; };
    var label = function (t) { var a = t.split(":"), h = +a[0], m = +a[1]; return (h % 12 || 12) + (m ? ":" + a[1] : "") + (h < 12 ? " AM" : " PM"); };
    var today = H[day], msg;
    if (today.open && now >= num(today.open) && now < num(today.close)) msg = "Open now until " + label(today.close);
    else if (today.open && now < num(today.open)) msg = "Closed now. Opens today at " + label(today.open);
    else for (var i = 1; i <= 7; i++) { var d = H[(day + i) % 7]; if (d.open) { msg = "Closed now. Opens " + (i === 1 ? "tomorrow" : d.day) + " at " + label(d.open); break; } }
    document.querySelectorAll("[data-status]").forEach(function (el) { el.textContent = msg; });
    document.querySelectorAll('table.hours tr[data-day="' + day + '"]').forEach(function (tr) { tr.classList.add("today"); });
    document.documentElement.classList.add(today.open && now >= num(today.open) && now < num(today.close) ? "is-open" : "is-closed");
  } catch (e) {}
})();
</script>
</body>
</html>
